# ---- App ----
APP_NAME="Threat Detection Platform"
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string-in-production
API_V1_PREFIX=/api/v1

# ---- Database ----
# SQLite (zero setup):
DATABASE_URL=sqlite+aiosqlite:///./threat_platform.db
# Postgres (docker compose sets this automatically):
# DATABASE_URL=postgresql+asyncpg://threat:threat@postgres:5432/threat_platform
AUTO_CREATE_TABLES=true

# ---- Auth ----
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Redis (optional; realtime falls back to in-process) ----
REDIS_URL=

# ---- Bootstrap admin ----
FIRST_ADMIN_EMAIL=admin@threatplatform.dev
FIRST_ADMIN_PASSWORD=Admin@12345

# ---- Detection ----
DETECTION_CONTENT_PATH=../detection-content

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
