{
  "buildCommand": "npm run build -- --base=/",
  "outputDirectory": "dist",
  "framework": "vite",
  "routes": [
    {
      "src": "/api/v1/health",
      "dest": "/api/v1/health.js"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/docs/?",
      "dest": "/docs/index.html"
    },
    {
      "src": "/docs/(.*)",
      "dest": "/docs/$1"
    },
    {
      "src": "/redoc/?",
      "dest": "/redoc/index.html"
    },
    {
      "src": "/openapi.json",
      "dest": "/openapi.json"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
