# GitHub Pages production build — no live backend needed.
# The app automatically runs in "SOC Sandbox" (full demo) mode when VITE_API_URL is empty.
# VITE_BASE_PATH is the sub-path GitHub Pages serves the app from.
VITE_API_URL=https://unified-threat-platform-backend.onrender.com
VITE_BASE_PATH=/unified-threat-platform/
