# ============================================================
# Unified Threat Detection & Response Platform — .env.example
# Copy this file to .env and fill in your real values.
# ============================================================

# ---- App ----
APP_NAME="Unified Threat Detection & Response Platform"
ENVIRONMENT=development
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string-in-production
API_V1_PREFIX=/api/v1

# ---- Database ----
DATABASE_URL=sqlite+aiosqlite:///./threat_platform.db
# Production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://threat_admin:StrongPassword@postgres:5432/threat_platform_prod
AUTO_CREATE_TABLES=true
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# ---- Auth ----
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Redis (optional; realtime pub/sub falls back to in-process) ----
REDIS_URL=
# Production:
# REDIS_URL=redis://:RedisPassword@redis:6379/0

# ---- Bootstrap admin (MUST change in production) ----
FIRST_ADMIN_EMAIL=admin@threatplatform.dev
FIRST_ADMIN_PASSWORD=Admin@12345

# ---- Detection ----
DETECTION_CONTENT_PATH=../detection-content

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Scheduling ----
ENABLE_BACKGROUND_SCHEDULER=true
SCHEDULER_INTERVAL_SECONDS=60

# ================================================================
# SMTP EMAIL ALERTS (required for real email notifications)
# ================================================================
# Without this: system runs in audit/mock mode (logs emails, no send)
# 
# Gmail setup:
#   1. Enable 2FA at https://myaccount.google.com/security
#   2. Generate App Password at https://myaccount.google.com/apppasswords
#   3. Use the 16-char app password below
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your-gmail@gmail.com
ALERT_EMAIL_RECIPIENT=soc-admin@yourcollege.edu

# ================================================================
# WEBHOOK ALERTS (optional — Slack, Teams, SIEM)
# ================================================================
WEBHOOK_ALERT_URL=
WEBHOOK_SIGNING_SECRET=threat-platform-webhook-secret

# ================================================================
# FRONTEND — Gemini API Key
# Put this in: frontend/.env.local (NOT this file)
# ================================================================
# VITE_GEMINI_API_KEY=AIzaSy...
# Get a FREE key at: https://aistudio.google.com/apikey
