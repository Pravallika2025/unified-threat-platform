# ==========================================
# Threat Detection Platform Environment Config
# ==========================================

# ---- Application Environment ----
APP_NAME="Unified Threat Detection Platform"
ENVIRONMENT=development  # Change to 'production' in production
# In production, generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string-in-production
API_V1_PREFIX=/api/v1

# ---- Database ----
# Development (SQLite zero setup):
DATABASE_URL=sqlite+aiosqlite:///./threat_platform.db
# Production (PostgreSQL with asyncpg):
# DATABASE_URL=postgresql+asyncpg://threat_admin:StrongPassword@postgres:5432/threat_platform_prod
AUTO_CREATE_TABLES=true
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# ---- Auth & Sessions ----
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Redis (Task Queue & Realtime Pub/Sub) ----
REDIS_URL=
# Production:
# REDIS_URL=redis://:RedisPassword@redis:6379/0

# ---- Bootstrap Administrator (MUST change in production) ----
FIRST_ADMIN_EMAIL=admin@threatplatform.dev
FIRST_ADMIN_PASSWORD=Admin@12345

# ---- Detection Rules Path ----
DETECTION_CONTENT_PATH=../detection-content

# ---- CORS & Security ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENABLE_BACKGROUND_SCHEDULER=true
SCHEDULER_INTERVAL_SECONDS=60
